---
/**
 * Sitewide header: brand + primary nav.
 * Mobile-first and progressively enhanced: without JS the nav is simply
 * visible (stacked). A small inline script enables a collapsible menu button
 * on narrow screens — using a real <button aria-expanded> for accessibility.
 */
import { SITE, NAV } from "../config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <button
      type="button"
      class="nav-toggle-btn"
      aria-expanded="false"
      aria-controls="primary-nav"
      hidden
    >
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Progressive enhancement: reveal the toggle button and wire collapse.
  (function () {
    var header = document.querySelector("[data-header]");
    if (!header) return;
    var btn = header.querySelector(".nav-toggle-btn");
    var nav = header.querySelector("#primary-nav");
    if (!btn || !nav) return;
    btn.hidden = false;
    header.setAttribute("data-js", "");
    btn.addEventListener("click", function () {
      var open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
    });
    // Close the menu after following a link (mobile).
    nav.addEventListener("click", function (e) {
      if (e.target.closest("a")) btn.setAttribute("aria-expanded", "false");
    });
  })();
</script>

<style>
  .site-header {
    background: var(--color-bg);
    border-top: 3px solid var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 1.0625rem;
  }
  .brand-mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--color-accent);
    box-shadow: inset 0 0 0 3px var(--color-primary);
    flex: none;
  }

  .nav-toggle-btn {
    background: transparent;
    cursor: pointer;
    padding: 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: inline-flex;
    align-items: center;
  }
  .nav-toggle-bar,
  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    position: relative;
  }
  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .nav-toggle-bar::before { top: -6px; }
  .nav-toggle-bar::after { top: 6px; }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .site-nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-ink);
    text-decoration: none;
    border-radius: var(--radius);
    font-weight: 500;
  }
  .site-nav a:hover { background: var(--color-surface); }
  .site-nav a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--color-accent);
  }

  /* Narrow screens WITH JS: collapse nav behind the button. */
  @media (max-width: 819px) {
    [data-js] .site-nav {
      flex-basis: 100%;
    }
    [data-js] .nav-toggle-btn[aria-expanded="false"] + .site-nav {
      display: none;
    }
    [data-js] .site-nav ul {
      flex-direction: column;
      padding-bottom: var(--space-2);
    }
    [data-js] .site-nav a { padding: var(--space-3); }
  }
</style>

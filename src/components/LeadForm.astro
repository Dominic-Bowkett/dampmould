---
/**
 * LeadForm — enquiry / lead capture. Two modes:
 *
 *  - mode="post" (DEFAULT): submits to the Cloudflare Pages Function /api/lead,
 *    which sends the enquiry to you by email (via Resend). The form sends by
 *    itself — no email client opens. Falls back to a full-page POST without JS.
 *  - mode="email": builds a pre-filled email and opens the visitor's own email
 *    client (mailto:) — no backend needed.
 *
 * Honeypot field "company" is hidden from humans and dropped if filled.
 */
import { SITE } from "../config";

interface Props {
  /** Tailors copy + appears in the email so you know which form it came from. */
  audience?: "tenant" | "landlord" | "professional";
  heading?: string;
  intro?: string;
  cta?: string;
  /** "post" = serverless auto-send (default), "email" = mailto. */
  mode?: "email" | "post";
  /** Email subject line (email mode). */
  subject?: string;
}
const {
  audience = "tenant",
  heading = "Get help with your damp & mould issue",
  intro = "Tell us a little about your situation and we'll point you in the right direction.",
  cta = "Send",
  mode = "post",
  subject = "Website enquiry — Damp & Mould Hub",
} = Astro.props;

const formId = `lead-${Math.random().toString(36).slice(2, 8)}`;
const action = mode === "email" ? `mailto:${SITE.contactEmail}` : "/api/lead";
---

<section class="lead-form card" aria-labelledby={`${formId}-h`}>
  <h2 id={`${formId}-h`} class="lead-heading">{heading}</h2>
  <p class="lead-intro">{intro}</p>

  <form
    id={formId}
    class="lead"
    method="post"
    action={action}
    enctype={mode === "email" ? "text/plain" : undefined}
    data-lead-form
    data-mode={mode}
    data-email={SITE.contactEmail}
    data-subject={subject}
  >
    <input type="hidden" name="audience" value={audience} />

    <!-- Honeypot: visually hidden + aria-hidden; real users never see it. -->
    <div class="hp" aria-hidden="true">
      <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="field">
      <label for={`${formId}-name`}>Your name</label>
      <input id={`${formId}-name`} name="name" type="text" required autocomplete="name" />
    </div>

    <div class="field">
      <label for={`${formId}-email`}>Your email</label>
      <input id={`${formId}-email`} name="email" type="email" required autocomplete="email" />
    </div>

    <div class="field">
      <label for={`${formId}-postcode`}>Postcode <span class="opt">(optional)</span></label>
      <input id={`${formId}-postcode`} name="postcode" type="text" autocomplete="postal-code" />
    </div>

    <div class="field">
      <label for={`${formId}-situation`}>Your situation <span class="opt">(optional)</span></label>
      <textarea id={`${formId}-situation`} name="situation" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-accent">{cta}</button>

    <p class="lead-status" data-lead-status role="status" aria-live="polite" hidden></p>
    <p class="lead-privacy">
      {mode === "email"
        ? "Clicking ‘Send’ opens your own email app with the details filled in — you stay in control and just press send."
        : "We use your details only to respond to your enquiry."}
      See our <a href="/privacy">privacy notice</a>.
    </p>
  </form>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-lead-form]").forEach(function (form) {
      var status = form.querySelector("[data-lead-status]");
      var mode = form.getAttribute("data-mode") || "email";

      function showStatus(msg, kind) {
        if (!status) return;
        status.hidden = false;
        status.textContent = msg;
        status.classList.remove("ok", "err");
        if (kind) status.classList.add(kind);
      }

      function fields() {
        var f = new FormData(form);
        return {
          company: (f.get("company") || "").toString(),
          name: (f.get("name") || "").toString().trim(),
          email: (f.get("email") || "").toString().trim(),
          postcode: (f.get("postcode") || "").toString().trim(),
          situation: (f.get("situation") || "").toString().trim(),
          audience: (f.get("audience") || "").toString(),
        };
      }

      form.addEventListener("submit", async function (e) {
        var d = fields();
        // Honeypot — silently stop bots.
        if (d.company) { e.preventDefault(); return; }

        if (mode === "email") {
          // Build a pre-filled email and open the visitor's own mail client.
          e.preventDefault();
          if (!d.name || !d.email) {
            showStatus("Please add your name and email first.", "err");
            return;
          }
          var to = form.getAttribute("data-email");
          var subject = form.getAttribute("data-subject") || "Website enquiry";
          var lines = [
            "Name: " + d.name,
            "Email: " + d.email,
            "Postcode: " + (d.postcode || "—"),
            "Enquiry type: " + (d.audience || "—"),
            "",
            "Message:",
            d.situation || "—",
          ];
          var href =
            "mailto:" + to +
            "?subject=" + encodeURIComponent(subject) +
            "&body=" + encodeURIComponent(lines.join("\r\n"));
          window.location.href = href;
          showStatus(
            "Opening your email app… If nothing happens, email us at " + to + ".",
            "ok"
          );
          return;
        }

        // mode === "post": serverless submit via fetch.
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        showStatus("Sending…");
        try {
          var res = await fetch(form.action, {
            method: "POST",
            headers: { "content-type": "application/json", accept: "application/json" },
            body: JSON.stringify(d),
          });
          var j = await res.json().catch(function () { return {}; });
          if (res.ok && j.ok) {
            form.reset();
            showStatus(j.message || "Thanks — we’ll be in touch.", "ok");
          } else {
            showStatus(j.error || "Something went wrong. Please try again.", "err");
            btn.disabled = false;
          }
        } catch (err) {
          showStatus("Network error. Please try again.", "err");
          btn.disabled = false;
        }
      });
    });
  })();
</script>

<style>
  .lead-form { margin-block: var(--space-12); }
  .lead-heading { margin-top: 0; font-size: 1.375rem; }
  .lead-intro { color: var(--color-muted); }
  .field { margin-bottom: var(--space-4); }
  .field label { display: block; font-weight: 600; margin-bottom: var(--space-1); }
  .opt { font-weight: 400; color: var(--color-muted); }
  .field input,
  .field textarea {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font: inherit;
    color: var(--color-ink);
    background: var(--color-bg);
  }
  .field input:focus,
  .field textarea:focus { border-color: var(--color-primary); }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .lead-status { margin-top: var(--space-4); font-weight: 600; }
  .lead-status.ok { color: var(--color-accent-dark); }
  .lead-status.err { color: var(--color-warn); }
  .lead-privacy { font-size: 0.8125rem; color: var(--color-muted); margin-top: var(--space-4); }
</style>

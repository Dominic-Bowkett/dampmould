---
/**
 * /privacy — privacy notice. Linked from every LeadForm. UK GDPR-aligned, but
 * the legally-specific bits (controller identity, contact, processors, retention
 * periods) are left as TODOs for Dom to confirm before launch.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../config";
import { graph, organizationSchema, breadcrumbSchema } from "../lib/schema";
import type { Crumb } from "../lib/schema";

const title = "Privacy Notice";
const description =
  "How the Damp & Mould Hub collects, uses and protects your personal data, and your rights under UK data protection law.";

const crumbs: Crumb[] = [
  { label: "Home", href: "/" },
  { label: "Privacy", href: "/privacy" },
];
const schema = graph(organizationSchema(), breadcrumbSchema(crumbs));

const updated = new Date("2026-06-04");
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={title} description={description} schema={[schema]}>
  <div class="container">
    <article class="measure legal">
      <Breadcrumbs crumbs={crumbs} />

      <h1>Privacy notice</h1>
      <p class="updated">Last updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></p>

      <p>
        This notice explains how {SITE.name} ("we", "us") collects and uses your
        personal data, and your rights under UK data protection law (the UK GDPR
        and the Data Protection Act 2018).
      </p>

      <!-- TODO: Dom to confirm the data controller's legal identity and a
           contact email/address before launch, and register with the ICO if
           required. -->
      <h2>Who we are</h2>
      <p>
        The data controller for this site is
        <strong>[TODO: controller name / business details]</strong>. You can
        contact us about privacy at
        <strong>[TODO: privacy contact email]</strong> or via our
        <a href="/contact">contact page</a>.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>Information you give us</strong> through our forms — typically
          your name, email address, postcode and a description of your situation,
          plus the type of enquiry.
        </li>
        <li>
          <strong>Usage data</strong> — basic, largely anonymised analytics about
          how the site is used (for example pages viewed), to help us improve it.
          <!-- TODO: confirm analytics provider (e.g. GA4) and update the cookies
               section once configured. -->
        </li>
      </ul>

      <h2>How and why we use it</h2>
      <ul>
        <li>To <strong>respond to your enquiry</strong> and provide the help or information you've asked for.</li>
        <li>Where relevant and with an appropriate lawful basis, to <strong>connect you with regulated help</strong> (for example an SRA-regulated solicitor) — see "Sharing" below.</li>
        <li>To <strong>operate and improve</strong> the website.</li>
      </ul>
      <p>
        Our lawful bases are typically your <strong>consent</strong> and our
        <strong>legitimate interests</strong> in responding to enquiries and
        running the site.
        <!-- TODO: confirm the lawful bases that apply once processing is final. -->
      </p>

      <h2>Sharing your information</h2>
      <p>
        We do not sell your personal data. We may share it with service providers
        who help us operate the site, and — only where you've asked for that kind
        of help and with an appropriate lawful basis — with a regulated partner
        such as a solicitor.
        <!-- TODO: name any processors (form/email/CRM provider) and any
             solicitor referral partner, and confirm the lawful basis, before
             activating referrals. Claims-referral arrangements are regulated. -->
      </p>

      <h2>How long we keep it</h2>
      <p>
        We keep your data only as long as necessary for the purposes above, then
        delete or anonymise it.
        <strong>[TODO: state retention periods.]</strong>
      </p>

      <h2>Your rights</h2>
      <p>Under UK data protection law you have rights to:</p>
      <ul>
        <li>access the personal data we hold about you;</li>
        <li>have inaccurate data corrected;</li>
        <li>have your data erased in certain circumstances;</li>
        <li>restrict or object to certain processing;</li>
        <li>data portability; and</li>
        <li>withdraw consent at any time, where processing relies on consent.</li>
      </ul>
      <p>
        To exercise any of these, contact us using the details above. You also
        have the right to complain to the Information Commissioner's Office (ICO)
        at <a href="https://ico.org.uk" rel="nofollow">ico.org.uk</a>.
      </p>

      <h2>Cookies and analytics</h2>
      <p>
        We aim to keep cookies to a minimum. Where we use analytics, we'll set out
        the details here and provide any controls required.
        <!-- TODO: complete this section once GA4 / any cookies are configured,
             and add a cookie banner if required. -->
      </p>

      <h2>Changes to this notice</h2>
      <p>
        We may update this notice from time to time. The "last updated" date above
        shows when it last changed.
      </p>

      <blockquote class="warn">
        This is a starting-point privacy notice and must be reviewed and
        completed (controller details, processors, retention, lawful bases,
        cookies) before the site goes live and collects real data.
      </blockquote>
    </article>
  </div>
</BaseLayout>

<style>
  .legal { padding-block: var(--space-8) var(--space-12); }
  .updated { color: var(--color-muted); font-size: 0.875rem; margin-top: calc(-1 * var(--space-2)); }
  .legal h2 { margin-top: var(--space-8); }
  .legal ul { padding-left: 1.25rem; }
  .legal li { margin-bottom: var(--space-2); }
  .legal blockquote.warn {
    margin: var(--space-8) 0 0;
    padding: var(--space-4) var(--space-6);
    border-left: 4px solid var(--color-warn);
    background: var(--color-warn-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
</style>

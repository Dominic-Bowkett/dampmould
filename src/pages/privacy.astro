---
/**
 * /privacy — privacy notice (UK GDPR / DPA 2018 / PECR). Linked from every
 * LeadForm and the consent banner. Reflects the site's actual data flows:
 * mailto enquiry forms, Cloudflare hosting, and Google Analytics 4 gated behind
 * consent.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, AUTHOR } from "../config";
import { graph, organizationSchema, breadcrumbSchema } from "../lib/schema";
import type { Crumb } from "../lib/schema";

const title = "Privacy Notice";
const description =
  "How the Damp & Mould Hub collects, uses and protects your personal data, and your rights under UK data protection law.";

const crumbs: Crumb[] = [
  { label: "Home", href: "/" },
  { label: "Privacy", href: "/privacy" },
];
const schema = graph(organizationSchema(), breadcrumbSchema(crumbs));

const updated = new Date("2026-06-05");
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={title} description={description} schema={[schema]}>
  <div class="container">
    <article class="measure legal">
      <Breadcrumbs crumbs={crumbs} />

      <h1>Privacy notice</h1>
      <p class="updated">Last updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></p>

      <p>
        This notice explains how {SITE.name} ("we", "us") collects and uses your
        personal data, and your rights under UK data protection law (the UK GDPR
        and the Data Protection Act 2018).
      </p>

      <h2>Who we are</h2>
      <p>
        This site, {SITE.name}, is operated by <strong>{AUTHOR.name}</strong>, who
        is the data controller responsible for your personal data. You can contact
        us about privacy or anything in this notice by email at
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> or via our
        <a href="/contact">contact page</a>. A postal address is available on
        request.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>Enquiry details you send us.</strong> When you submit an enquiry
          form (typically your name, email address, postcode and message), it is
          sent to us by email so we can respond to you. We don't store these
          submissions in a database on the website.
        </li>
        <li>
          <strong>Analytics data</strong> — but only if you accept analytics
          cookies (see "Cookies and analytics" below). This is aggregated usage
          information, such as pages viewed and approximate location, used to
          understand and improve the site.
        </li>
        <li>
          <strong>Technical data</strong> — like most websites, our hosting
          provider automatically processes limited technical information (such as
          your IP address and browser type) in server logs, to deliver the site
          securely and reliably.
        </li>
      </ul>

      <h2>How and why we use it, and our lawful basis</h2>
      <ul>
        <li>
          <strong>To respond to your enquiry</strong> and provide the help or
          information you've asked for. Lawful basis: our
          <strong>legitimate interests</strong> (and, where relevant, taking steps
          at your request before any agreement).
        </li>
        <li>
          <strong>To operate, secure and maintain the website.</strong> Lawful
          basis: our <strong>legitimate interests</strong> in running a safe,
          working site.
        </li>
        <li>
          <strong>To measure and improve the site</strong> using analytics. Lawful
          basis: your <strong>consent</strong>, which you give via the cookie
          banner and can withdraw at any time.
        </li>
      </ul>

      <h2>Who we share it with</h2>
      <p>
        We do <strong>not</strong> sell your personal data. We use a small number
        of trusted service providers who process data on our behalf:
      </p>
      <ul>
        <li>
          <strong>Cloudflare</strong> — hosts the website and provides security and
          content delivery (processes technical data such as IP addresses).
        </li>
        <li>
          <strong>Google Analytics</strong> — provides website analytics, used only
          if you accept analytics cookies.
        </li>
        <li>
          <strong>Resend</strong> — our email delivery provider, used to send your
          enquiry from the website to our inbox.
        </li>
        <li>
          <strong>Our email provider</strong> — receives and stores the enquiry
          emails so we can read and reply to them.
        </li>
      </ul>
      <p>
        We may also disclose information if required by law. We do not currently
        operate a solicitor-referral service; if we introduce one, we will update
        this notice and will only share your details with a regulated partner
        where we have a lawful basis to do so.
      </p>

      <h2>International transfers</h2>
      <p>
        Some of our providers (such as Google and Cloudflare) may process data
        outside the UK. Where they do, transfers are protected by appropriate
        safeguards recognised under UK data protection law, such as the UK
        International Data Transfer Agreement or equivalent.
      </p>

      <h2>How long we keep it</h2>
      <ul>
        <li>
          <strong>Enquiry emails:</strong> kept only as long as needed to deal with
          your enquiry and for a reasonable period afterwards — normally no longer
          than 24 months after our last contact — unless we need to keep them
          longer for legal reasons.
        </li>
        <li>
          <strong>Analytics data:</strong> retained in Google Analytics for up to
          14 months.
        </li>
        <li>
          <strong>Server logs:</strong> kept only for a short period for security
          and troubleshooting.
        </li>
      </ul>

      <h2>Your rights</h2>
      <p>Under UK data protection law you have rights to:</p>
      <ul>
        <li>access the personal data we hold about you;</li>
        <li>have inaccurate data corrected;</li>
        <li>have your data erased in certain circumstances;</li>
        <li>restrict or object to certain processing;</li>
        <li>data portability; and</li>
        <li>withdraw consent at any time, where processing relies on consent.</li>
      </ul>
      <p>
        To exercise any of these, contact us using the details above. You also
        have the right to complain to the Information Commissioner's Office (ICO)
        at <a href="https://ico.org.uk" rel="nofollow">ico.org.uk</a>.
      </p>

      <h2>Cookies and analytics</h2>
      <p>
        We keep cookies to a minimum. <strong>No analytics or marketing cookies
        are set unless you accept them</strong> using the cookie banner when you
        first visit.
      </p>
      <ul>
        <li>
          <strong>Strictly necessary:</strong> a small amount of local storage is
          used only to remember your cookie choice. This is essential and needs no
          consent.
        </li>
        <li>
          <strong>Analytics (optional):</strong> if you accept, Google Analytics 4
          sets cookies (such as <code>_ga</code>) to measure how the site is used.
          We use Google Consent Mode, so these are not set while consent is
          declined.
        </li>
      </ul>
      <p>
        You can change your mind at any time using the
        <strong>“Cookie settings”</strong> link in the footer, which reopens the
        banner. You can also block or delete cookies in your browser settings.
      </p>

      <h2>Changes to this notice</h2>
      <p>
        We may update this notice from time to time. The "last updated" date above
        shows when it last changed.
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .legal { padding-block: var(--space-8) var(--space-12); }
  .updated { color: var(--color-muted); font-size: 0.875rem; margin-top: calc(-1 * var(--space-2)); }
  .legal h2 { margin-top: var(--space-8); }
  .legal ul { padding-left: 1.25rem; }
  .legal li { margin-bottom: var(--space-2); }
  .legal code {
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>

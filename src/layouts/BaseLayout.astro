---
/**
 * BaseLayout — the HTML shell every page uses: <head> via BaseHead, skip link,
 * header, <main>, footer. Page content goes in the default slot.
 */
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { SITE } from "../config";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  schema?: Array<Record<string, unknown>>;
}

const { title, description, canonical, ogImage, ogType, schema } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      schema={schema}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {SITE.ga4Id && <ConsentBanner />}
  </body>
</html>
